---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';

interface Heading { depth: number; slug: string; text: string }
interface NavLink { number: number; title: string; slug: string }
interface Props {
  data: {
    number: number; title: string; summary: string; icon: string;
    category: string; readTime: number;
  };
  headings: Heading[];
  prev?: NavLink | null;
  next?: NavLink | null;
}
const { data, headings, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={`${String(data.number).padStart(2, '0')}. ${data.title}`} description={data.summary}>
  <div class="mod-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={base || '/'}>Home</a>
        <span>/</span>
        <a href={`${base}/#modules`}>Modules</a>
        <span>/</span>
        <span class="crumb-current">Module {data.number}</span>
      </nav>
      <div class="mod-head">
        <div class="mod-badge" aria-hidden="true"><Icon name={data.icon} size={30} /></div>
        <div>
          <div class="mod-chips">
            <span class="chip chip-muted">Module {String(data.number).padStart(2, '0')}</span>
            <span class="chip">{data.category}</span>
            <span class="chip chip-amber">~{data.readTime} min read</span>
          </div>
          <h1>{data.title}</h1>
          <p class="mod-summary">{data.summary}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="container mod-grid">
    <article class="prose">
      <slot />
      {(prev || next) && (
        <nav class="mod-pager" aria-label="Module navigation">
          {prev ? (
            <a class="pager-link prev" href={`${base}/modules/${prev.slug}`}>
              <span class="pager-dir">← Previous</span>
              <span class="pager-title">{String(prev.number).padStart(2, '0')}. {prev.title}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="pager-link next" href={`${base}/modules/${next.slug}`}>
              <span class="pager-dir">Next →</span>
              <span class="pager-title">{String(next.number).padStart(2, '0')}. {next.title}</span>
            </a>
          ) : <span></span>}
        </nav>
      )}
    </article>

    <aside class="mod-side">
      <div class="side-sticky">
        {toc.length > 0 && (
          <nav class="toc" aria-label="On this page">
            <p class="toc-title">On this page</p>
            <ul>
              {toc.map((h) => (<li><a href={`#${h.slug}`}>{h.text}</a></li>))}
            </ul>
          </nav>
        )}
        <a class="btn btn-ghost side-back" href={`${base}/#modules`}>All 20 modules</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .mod-hero { background: linear-gradient(180deg, var(--bg-alt), var(--bg)); border-bottom: 1px solid var(--border); padding: 1.4rem 0 2rem; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; font-size: 0.85rem; color: var(--text-faint); margin-bottom: 1.2rem; }
  .crumbs a { color: var(--text-muted); }
  .crumb-current { color: var(--text); font-weight: 600; }
  .mod-head { display: flex; gap: 1.1rem; align-items: flex-start; }
  .mod-badge { flex: 0 0 auto; width: 58px; height: 58px; display: grid; place-items: center; border-radius: 16px; background: var(--primary); color: #fff; box-shadow: var(--shadow-md); }
  :root[data-theme='dark'] .mod-badge { background: var(--surface-2); color: var(--accent); border: 1px solid var(--border-strong); }
  .mod-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.7rem; }
  .mod-summary { color: var(--text-muted); font-size: 1.05rem; max-width: 68ch; margin-bottom: 0; }

  .mod-grid { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 2.5rem; padding-top: 2rem; }
  .mod-side { display: block; }
  .side-sticky { position: sticky; top: calc(var(--header-h) + 20px); display: flex; flex-direction: column; gap: 1rem; }
  .toc { border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem 1.1rem; background: var(--surface); }
  .toc-title { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-faint); margin: 0 0 0.6rem; }
  .toc ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .toc a { display: block; padding: 0.3rem 0; color: var(--text-muted); font-size: 0.88rem; border-left: 2px solid transparent; padding-left: 0.6rem; }
  .toc a:hover, .toc a.active { color: var(--accent); border-left-color: var(--accent); text-decoration: none; }
  .side-back { justify-content: center; }

  .mod-pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-top: 3rem; padding-top: 1.6rem; border-top: 1px solid var(--border); }
  .pager-link { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.9rem 1.1rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--surface); transition: all 0.15s ease; }
  .pager-link:hover { border-color: var(--accent); background: var(--surface-2); text-decoration: none; transform: translateY(-2px); }
  .pager-link.next { text-align: right; }
  .pager-dir { font-size: 0.78rem; color: var(--text-faint); font-weight: 600; }
  .pager-title { font-weight: 700; color: var(--text); font-size: 0.95rem; }

  @media (max-width: 900px) {
    .mod-grid { grid-template-columns: 1fr; }
    .mod-side { display: none; }
  }
  @media (max-width: 560px) {
    .mod-pager { grid-template-columns: 1fr; }
    .pager-link.next { text-align: left; }
  }
</style>

<script>
  // active-section highlighting in the TOC
  const links = Array.from(document.querySelectorAll('.toc a'));
  const map = new Map();
  links.forEach((a) => { const id = a.getAttribute('href').slice(1); const el = document.getElementById(id); if (el) map.set(el, a); });
  if (map.size) {
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          links.forEach((l) => l.classList.remove('active'));
          map.get(en.target)?.classList.add('active');
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px', threshold: 0 });
    map.forEach((_, el) => obs.observe(el));
  }
</script>
