---
import Icon from './Icon.astro';
interface Props {
  number: number; title: string; summary: string; icon: string;
  category: string; readTime: number; slug: string;
}
const { number, title, summary, icon, category, readTime, slug } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="card" href={`${base}/modules/${slug}`} data-category={category} data-text={`${title} ${summary} ${category}`.toLowerCase()}>
  <div class="card-top">
    <span class="card-num">{String(number).padStart(2, '0')}</span>
    <span class="card-icon" aria-hidden="true"><Icon name={icon} size={22} /></span>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-sum">{summary}</p>
  <div class="card-foot">
    <span class="chip chip-muted">{category}</span>
    <span class="card-read">~{readTime} min</span>
  </div>
</a>

<style>
  .card {
    display: flex; flex-direction: column; gap: 0.55rem;
    padding: 1.3rem 1.3rem 1.1rem; height: 100%;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: var(--radius); box-shadow: var(--shadow-sm);
    color: var(--text); transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  }
  .card:hover { text-decoration: none; transform: translateY(-4px); box-shadow: var(--shadow-md); border-color: var(--accent); }
  .card-top { display: flex; align-items: center; justify-content: space-between; }
  .card-num { font-family: var(--font-mono); font-size: 1.25rem; font-weight: 600; color: var(--accent); }
  .card-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 11px; background: var(--surface-2); color: var(--primary); border: 1px solid var(--border); }
  :root[data-theme='dark'] .card-icon { color: var(--accent); }
  .card-title { margin: 0.1rem 0 0; font-size: 1.08rem; line-height: 1.3; }
  .card-sum { margin: 0; color: var(--text-muted); font-size: 0.9rem; flex: 1; }
  .card-foot { display: flex; align-items: center; justify-content: space-between; margin-top: 0.4rem; }
  .card-read { font-size: 0.8rem; color: var(--text-faint); font-family: var(--font-mono); }
</style>
