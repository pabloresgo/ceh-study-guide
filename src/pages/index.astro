---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ModuleCard from '../components/ModuleCard.astro';

const modules = (await getCollection('modules')).sort((a, b) => a.data.number - b.data.number);
const categories = ['All', ...Array.from(new Set(modules.map((m) => m.data.category)))];
const totalTools = modules.reduce((n, m) => n + m.data.tools.length, 0);
---
<BaseLayout title="CEH Study Guide">
  <!-- hero -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="chip chip-amber hero-kicker">Personal study guide · 20 modules</span>
      <h1>Certified Ethical Hacker,<br /><span class="hero-accent">organized for study.</span></h1>
      <p class="hero-sub">
        A clean, searchable reference across all 20 CEH domains — core concepts, the tools that
        matter, example command syntax, and the defensive countermeasures for each topic.
        Built for authorized learning, labs, and exam prep.
      </p>
      <div class="hero-cta">
        <a class="btn btn-primary" href="#modules">Browse modules</a>
        <button class="btn btn-ghost" id="hero-search">Search everything <kbd>/</kbd></button>
      </div>
      <dl class="hero-stats">
        <div><dt>20</dt><dd>Modules</dd></div>
        <div><dt>{totalTools}+</dt><dd>Tools referenced</dd></div>
        <div><dt>6</dt><dd>Domains</dd></div>
      </dl>
    </div>
  </section>

  <!-- modules -->
  <section id="modules" class="modules-section">
    <div class="container">
      <div class="sec-head">
        <h2>The 20 modules</h2>
        <p>Filter by domain or jump straight to a topic.</p>
      </div>
      <div class="filter-bar" role="tablist" aria-label="Filter modules by category">
        {categories.map((c, i) => (
          <button class={`fb ${i === 0 ? 'active' : ''}`} data-filter={c} role="tab" aria-selected={i === 0}>{c}</button>
        ))}
      </div>
      <div class="card-grid" id="card-grid">
        {modules.map((m) => (
          <ModuleCard
            number={m.data.number}
            title={m.data.title}
            summary={m.data.summary}
            icon={m.data.icon}
            category={m.data.category}
            readTime={m.data.readTime}
            slug={m.slug}
          />
        ))}
      </div>
      <p class="grid-empty" id="grid-empty" hidden>No modules in this domain.</p>
    </div>
  </section>

  <!-- about -->
  <section id="about" class="about-section">
    <div class="container about-grid">
      <div>
        <h2>About this guide</h2>
        <p>
          This site turns a folder of study notes into a structured, dynamic reference. Each module
          follows the same shape — an overview, key concepts, a methodology, representative example
          commands, and defensive countermeasures — so you always know where to look.
        </p>
        <p>
          It's a learning aid: use it to understand attacker techniques <em>so you can defend against
          them</em>, to prepare for the CEH exam, and to practise in environments you're authorized to test.
        </p>
      </div>
      <aside class="about-card">
        <h3>How to use it</h3>
        <ul>
          <li>Press <kbd>/</kbd> anywhere to search across all modules.</li>
          <li>Each module has a filterable <strong>tool table</strong> with official sources.</li>
          <li>Hover a command block and hit <strong>Copy</strong>.</li>
          <li>Toggle light / dark from the header; your choice is remembered.</li>
        </ul>
        <div class="about-ethics">
          <strong>Ethics &amp; authorization</strong>
          <p>Only test systems you own or have explicit written permission to assess.</p>
        </div>
      </aside>
    </div>
  </section>

  <style>
    .hero { background: radial-gradient(1200px 400px at 70% -10%, color-mix(in srgb, var(--accent) 16%, transparent), transparent), linear-gradient(180deg, var(--bg-alt), var(--bg)); border-bottom: 1px solid var(--border); }
    .hero-inner { padding: 3.6rem 0 3.2rem; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .hero-kicker { margin-bottom: 1.2rem; }
    .hero h1 { margin: 0 0 1rem; }
    .hero-accent { color: var(--accent); }
    .hero-sub { max-width: 60ch; color: var(--text-muted); font-size: 1.1rem; margin: 0 auto 1.6rem; }
    .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; }
    .hero-cta kbd { font-family: var(--font-mono); font-size: 0.72rem; border: 1px solid var(--border-strong); border-radius: 5px; padding: 1px 6px; margin-left: 0.3rem; }
    .hero-stats { display: flex; gap: 2.6rem; margin: 2.4rem 0 0; padding: 0; }
    .hero-stats div { text-align: center; }
    .hero-stats dt { font-size: 2rem; font-weight: 800; color: var(--primary); font-family: var(--font-mono); }
    :root[data-theme='dark'] .hero-stats dt { color: var(--primary-hover); }
    .hero-stats dd { margin: 0; color: var(--text-muted); font-size: 0.85rem; }

    .modules-section { padding: 3.4rem 0; }
    .sec-head { text-align: center; margin-bottom: 1.6rem; }
    .sec-head h2 { margin: 0; }
    .sec-head p { color: var(--text-muted); margin: 0.3rem 0 0; }
    .filter-bar { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 2rem; }
    .fb { font-size: 0.85rem; font-weight: 600; padding: 0.45rem 0.95rem; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--text-muted); cursor: pointer; transition: all 0.15s ease; }
    .fb:hover { border-color: var(--border-strong); color: var(--text); }
    .fb.active { background: var(--primary); color: #fff; border-color: var(--primary); }
    :root[data-theme='dark'] .fb.active { background: var(--accent); color: #06231f; border-color: var(--accent); }

    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(255px, 1fr)); gap: 1.1rem; }
    .grid-empty { text-align: center; color: var(--text-muted); padding: 2rem; }

    .about-section { padding: 2rem 0 3.5rem; }
    .about-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2.4rem; align-items: start; }
    .about-grid h2 { margin-top: 0; }
    .about-grid p { color: var(--text-muted); }
    .about-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.4rem 1.5rem; box-shadow: var(--shadow-sm); }
    .about-card h3 { margin-top: 0; }
    .about-card ul { padding-left: 1.2rem; color: var(--text-muted); }
    .about-card li { margin: 0.5rem 0; }
    .about-card kbd { font-family: var(--font-mono); font-size: 0.72rem; border: 1px solid var(--border-strong); border-radius: 5px; padding: 1px 6px; }
    .about-ethics { margin-top: 1.2rem; padding: 0.9rem 1rem; border-radius: var(--radius-sm); background: var(--highlight-soft); border: 1px solid color-mix(in srgb, var(--highlight) 35%, transparent); }
    .about-ethics strong { color: var(--highlight); }
    .about-ethics p { margin: 0.3rem 0 0; color: var(--text-muted); font-size: 0.9rem; }

    @media (max-width: 760px) {
      .about-grid { grid-template-columns: 1fr; }
      .hero-stats { gap: 1.8rem; }
    }
  </style>

  <script>
    // category filter
    const buttons = document.querySelectorAll('.fb');
    const cards = Array.from(document.querySelectorAll('#card-grid .card'));
    const emptyEl = document.getElementById('grid-empty');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => { x.classList.remove('active'); x.setAttribute('aria-selected', 'false'); });
      b.classList.add('active'); b.setAttribute('aria-selected', 'true');
      const f = b.getAttribute('data-filter');
      let visible = 0;
      cards.forEach((c) => {
        const show = f === 'All' || c.getAttribute('data-category') === f;
        c.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyEl) emptyEl.hidden = visible > 0;
    }));
    // hero search button -> open modal
    document.getElementById('hero-search')?.addEventListener('click', () => document.getElementById('search-open')?.click());
  </script>
</BaseLayout>
